{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@atlas/core": ["packages/atlas-core/src/index.ts"],
      "@atlas/shared": ["packages/atlas-shared/src/index.ts"],
      "@atlas/types": ["packages/atlas-types/src/index.ts"],
      "@atlas/songer": ["packages/atlas-songer/src/index.ts"],
      "@atlas/creator": ["packages/atlas-creator/src/index.ts"]
    }
  }
}
