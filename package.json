{
  "name": "Atlas",
  "version": "1.0.0",
  "description": "Atlas Discord bot with modular dual-domain architecture (Songer + Creator).",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r exec tsc -p tsconfig.json --noEmit",
    "verify": "pnpm build && pnpm typecheck",
    "bot:dev": "pnpm --filter atlas-bot dev",
    "bot:build": "pnpm --filter atlas-bot build",
    "bot:start": "pnpm --filter atlas-bot start",
    "bot:deploy-commands": "pnpm --filter atlas-bot deploy:commands"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "dotenv": "^17.3.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.25.1",
    "zod": "^4.3.6"
  }
}
