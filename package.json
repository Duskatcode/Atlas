{
  "name": "Atlas",
  "version": "1.0.0",
  "private": true,
  "description": "Atlas monorepo",
  "main": "index.js",
  "scripts": {
    "build": "pnpm -r build",
    "build:creator": "pnpm --filter @atlas/creator build",
    "build:cli": "pnpm --filter atlas-cli build",
    "dev:bot": "pnpm --filter atlas-bot dev",
    "dev:cli": "pnpm --filter atlas-cli dev",
    "cli": "pnpm --filter atlas-cli start --"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "dotenv": "^17.3.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.25.1",
    "zod": "^4.3.6"
  }
}
